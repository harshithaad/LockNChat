# Copy to server/.env and adjust. Never commit the real .env.

NODE_ENV=development
PORT=3000

# Matches docker-compose.yml (host port 5433)
DATABASE_URL=postgres://locknchat:locknchat@localhost:5433/locknchat

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-at-least-32-random-characters

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Browsers accept Secure cookies on http://localhost; keep this true
COOKIE_SECURE=true

# Number of reverse proxies in front of the app (0 when running locally)
TRUST_PROXY=0
